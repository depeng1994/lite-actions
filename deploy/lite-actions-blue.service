[Unit]
Description=Lite Actions blue Pull worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lite-actions/current
EnvironmentFile=/etc/lite-actions/blue.env

# This is a deployment template, not a portable executable unit.
# Select an absolute Python 3.11+ interpreter on the target host.
# Do not assume /usr/bin/python3: Ubuntu 20.04 may resolve it to Python 3.8.
# Replace <PYTHON_3_11_OR_NEWER> with the host-validated path, e.g.
# /usr/local/bin/python3.12, in both commands when rendering the unit.
# ExecStartPre=<PYTHON_3_11_OR_NEWER> /opt/lite-actions/current/unified_router.py --worker-id blue --validate
# ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /root/.cache/lite-actions/phase1-agent.lock <PYTHON_3_11_OR_NEWER> -u /opt/lite-actions/current/unified_router.py --worker-id blue

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=900
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lite-actions-blue

[Install]
WantedBy=multi-user.target
