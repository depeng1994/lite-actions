[Unit]
Description=Lite Actions native smoke pilot (blue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lite-actions/native-pilot
EnvironmentFile=/etc/lite-actions/blue.env
EnvironmentFile=/etc/lite-actions/native-pilot.env
ExecStartPre=/usr/bin/python3 /opt/lite-actions/native-pilot/unified_router.py --worker-id blue --validate
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork /root/.cache/lite-actions/phase1-agent.lock /usr/bin/python3 -u /opt/lite-actions/native-pilot/unified_router.py --worker-id blue
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
