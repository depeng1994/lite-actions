# Trusted Git repository and branch to pull. No embedded credentials.
LITE_ACTIONS_UPDATE_GIT_URL=https://github.com/depeng1994/lite-actions.git
LITE_ACTIONS_UPDATE_GIT_REF=refs/heads/main

# An existing, explicitly configured Worker systemd unit.
LITE_ACTIONS_UPDATE_WORKER_UNIT=EXISTING_WORKER.service

# Immutable releases and external runtime state are kept separate.
LITE_ACTIONS_UPDATE_ROOT=/opt/lite-actions
LITE_ACTIONS_UPDATE_STATE_DIR=/var/lib/lite-actions/auto-update
LITE_ACTIONS_UPDATE_LOG_FILE=/var/log/lite-actions/management/updates.jsonl
LITE_ACTIONS_UPDATE_READY_FILE=/var/lib/lite-actions/worker-ready.json
LITE_ACTIONS_UPDATE_READY_TIMEOUT=120
